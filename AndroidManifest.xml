<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="com.xlythe.saolauncher.permission.EXTENSION_IPC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.telephony" />

    <permission android:name="com.xlythe.saolauncher.permission.EXTENSION_IPC" android:protectionLevel="signature" />
    <queries><package android:name="com.xlythe.saolauncher" /></queries>

    <application
        android:hardwareAccelerated="true"
        android:icon="@drawable/smspopup_icon"
        android:label="@string/app_name" >
        <activity android:name=".ui.MessageSetupActivity" android:exported="true"
            android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC" />
        <activity android:name=".ui.ComposeMessageActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" /><data android:scheme="smsto" />
                <data android:scheme="mms" /><data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <receiver android:name=".receiver.LauncherMessageReceiver" android:exported="false">
            <intent-filter><action android:name="com.xlythe.textmanager.text.ACTION_TEXT_RECEIVED" /></intent-filter>
        </receiver>
        <provider android:name=".provider.LauncherMessages" android:authorities="${applicationId}.messages"
            android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC" android:exported="true" />
        <activity
            android:name=".ui.SendSmsActivity" android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC"
            android:label="@string/app_name"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/DialogTheme" />
        <activity
            android:name=".ui.ReadSmsActivity" android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC"
            android:label="@string/app_name"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/DialogTheme" />
        <activity
            android:name=".ui.SaoWarningActivity"
            android:label="@string/app_name"
            android:theme="@style/DialogTheme"
            android:excludeFromRecents="true" />
        <activity
            android:name=".ui.SmsPopupConfigActivity" android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ConfigContactsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/pref_contacts_title"
            android:launchMode="singleTop" >
        </activity>
        <activity
            android:name=".ui.ConfigContactActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/pref_contacts_title"
            android:launchMode="singleTop" >
        </activity>
        <activity
            android:name=".ui.ConfigQuickMessagesActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/pref_message_presets_title"
            android:launchMode="singleTop" >
        </activity>
        <activity
            android:name=".ui.SmsPopupActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:launchMode="singleTask"
            android:screenOrientation="user"
            android:taskAffinity="com.xlythe.saolauncher.smsextension.popup"
            android:theme="@style/DialogTheme" >
        </activity>

        <receiver android:exported="true" android:name=".receiver.SmsReceiver" android:permission="android.permission.BROADCAST_SMS" >
            <intent-filter android:priority="999" >
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter android:priority="999" >
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED" />

                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <receiver android:name=".receiver.MessageEventReceiver" android:exported="true" android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC">
            <intent-filter android:priority="999" >
                <action android:name="com.xlythe.saolauncher.smsextension.MESSAGE_RECEIVED" />
            </intent-filter>
            <intent-filter android:priority="999" >
                <action android:name="com.android.mms.transaction.MESSAGE_SENT" />
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name=".receiver.ExternalEventReceiver" >
            <intent-filter>
                <action android:name="com.xlythe.saolauncher.smsextension.DONATED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DOCK_EVENT" />
            </intent-filter>
        </receiver>
        <receiver android:name=".receiver.ClearAllReceiver" />
        <receiver android:name=".receiver.ReminderReceiver" />

        <service android:name=".service.SmsPopupUtilsService" />
        <service android:name=".service.SmsReceiverService" />
        <service android:name=".service.ReminderService" />
        <service android:name=".service.SmsMonitorService" android:permission="com.xlythe.saolauncher.permission.EXTENSION_IPC" android:exported="true" />

        <provider
            android:name=".provider.SmsPopupContentProvider"
            android:authorities="com.xlythe.saolauncher.smsextension.provider"
            android:exported="false" />
    </application>

</manifest>